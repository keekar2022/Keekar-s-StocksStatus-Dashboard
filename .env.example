# --- EODHD (primary, required for OHLCV) -------------------------------------
# https://eodhd.com -- subscribe to "EOD Historical Data - All World" (~$17.99/mo)
# for global equities + ETFs across 70+ exchanges, or use the free trial token.
EODHD_API_KEY=your_token_here

# Default exchange suffix when a bare symbol is entered (e.g. AAPL -> AAPL.US).
# Common values: US, NSE, BSE, LSE, XETRA, TO, HK.
EODHD_DEFAULT_EXCHANGE=US

# Fundamentals: attempted automatically when EODHD_API_KEY is set (includes Free Cash Flow).
# Requires the EODHD Fundamentals add-on on your plan (~$53.99/mo); HTTP 403 falls back to EDGAR.
# Set to false to skip EODHD fundamentals and use SEC EDGAR only (US).
# EODHD_FUNDAMENTALS_ENABLED=false

# Yahoo PE/ROIC on Technical tab (off by default). yfinance often fails when
# fc.yahoo.com is blocked on corporate networks — leave false if you use EODHD.
YAHOO_PE_ROIC_ENABLE=false

# --- SEC EDGAR (free, US-only fundamentals enhancer) -------------------------
# SEC requires you to identify your client; include contact email or URL.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=Stocks-Dashboard-POC you@example.com

# --- Legacy multi-source chain (off by default) ------------------------------
# Set to true to restore the original Yahoo -> Alpha Vantage -> Investing.com chain
# (kept for offline / paid-key-not-available scenarios).
LEGACY_SOURCES=false

# Legacy: Alpha Vantage (https://www.alphavantage.co/support/#api-key)
# Only used when LEGACY_SOURCES=true.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_CALL_INTERVAL_SEC=12.5

# Legacy: Investing.com unofficial fallback. Only honoured when LEGACY_SOURCES=true.
INVESTING_ENABLE=true

# --- Nasdaq Data Link (optional supplementary preview) -----------------------
NASDAQ_DATA_LINK_API_KEY=
NASDAQ_DATA_LINK_CODE=
NASDAQ_DATA_LINK_ROWS=250
