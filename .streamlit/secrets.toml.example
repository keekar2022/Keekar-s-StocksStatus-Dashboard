# Local: run `python scripts/sync_secrets_from_env.py` to create .streamlit/secrets.toml from .env
# Cloud: paste into Streamlit App settings → Secrets (do not commit real secrets.toml).
#
# SEC requires a descriptive User-Agent: "AppName you@example.com"
# https://www.sec.gov/os/accessing-edgar-data

EODHD_API_KEY = "your_eodhd_token_here"
EODHD_DEFAULT_EXCHANGE = "US"
SEC_USER_AGENT = "Keekar-Stocks-Dashboard you@example.com"

# Optional
# OHLCV_PRIMARY = "yahoo"
# EODHD_OHLCV_FALLBACK = "true"
# OHLCV_CACHE_TTL_HOURS = "24"
# EODHD_FUNDAMENTALS_ENABLED = "true"
# YAHOO_PE_ROIC_ENABLE = "false"
